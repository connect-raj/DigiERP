DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Used by Prisma migrate commands (migrate dev/deploy/status) instead of DATABASE_URL.
# Only needs to differ from DATABASE_URL when DATABASE_URL points at a connection pooler
# (e.g. Neon's "-pooler" endpoint, PgBouncer) that doesn't support the advisory locks
# migrations need — point this at the same database's direct (non-pooled) connection.
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"
