// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  role              Role               @default(user)
  status            String             @default("active")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  vendorPayments    VendorPayment[]
  stockTransactions StockTransaction[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  hsnCode   String
  gstRate   Decimal   @db.Decimal(5, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              String             @id @default(uuid())
  name            String
  categoryId      String
  basePrice       Decimal            @db.Decimal(12, 2)
  unit            String             @default("LTR")
  currentStock    Decimal            @default(0) @db.Decimal(12, 3)
  lowerStockLimit Decimal            @default(0) @db.Decimal(12, 3)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  category        Category           @relation(fields: [categoryId], references: [id])
  vendorProducts    VendorProduct[]
  customerPrices    CustomerPrice[]
  stockTxns         StockTransaction[]
  purchaseItems     PurchaseItem[]
  dispatchEntryItems DispatchEntryItem[]
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  email          String?
  phone          String
  address        String
  state          String
  gstin          String?
  paymentTerms   String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vendorProducts VendorProduct[]
  purchases      Purchase[]
  vendorPayments VendorPayment[]
}

model VendorProduct {
  id          String  @id @default(uuid())
  vendorId    String
  productId   String
  isPreferred Boolean @default(false)
  vendor      Vendor  @relation(fields: [vendorId], references: [id])
  product     Product @relation(fields: [productId], references: [id])

  @@unique([vendorId, productId])
}

model CustomerPrice {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  price      Decimal  @db.Decimal(12, 2)
  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model StockTransaction {
  id              String         @id @default(uuid())
  productId       String
  changeQty       Decimal        @db.Decimal(12, 3)
  stockBefore     Decimal        @db.Decimal(12, 3)
  stockAfter      Decimal        @db.Decimal(12, 3)
  reason          String
  purchaseId      String?
  dispatchEntryId String?
  performedById   String?
  createdAt       DateTime       @default(now())
  product         Product        @relation(fields: [productId], references: [id])
  purchase        Purchase?      @relation(fields: [purchaseId], references: [id])
  dispatchEntry   DispatchEntry? @relation(fields: [dispatchEntryId], references: [id])
  performedBy     User?          @relation(fields: [performedById], references: [id])
}

model Customer {
  id                 String   @id @default(uuid())
  firmName           String
  state              String
  gstin              String?
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customerPrices  CustomerPrice[]
  dispatchEntries DispatchEntry[]
}

model DispatchEntry {
  id          String    @id @default(uuid())
  challanNo   String    @unique
  customerId  String
  place       String
  transport   String?
  date        DateTime
  entryDate   DateTime  @default(now())
  status      DocStatus @default(PENDING_BILLING)
  isCancelled Boolean   @default(false)
  totalAmount Decimal   @db.Decimal(12, 2)
  totalCgst   Decimal   @default(0) @db.Decimal(12, 2)
  totalSgst   Decimal   @default(0) @db.Decimal(12, 2)
  totalIgst   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer  Customer            @relation(fields: [customerId], references: [id])
  items     DispatchEntryItem[]
  invoice   Invoice?
  stockTxns StockTransaction[]
}

model DispatchEntryItem {
  id              String  @id @default(uuid())
  dispatchEntryId String
  productId       String
  quantity        Decimal @db.Decimal(12, 3)
  price           Decimal @db.Decimal(12, 2)
  cgst            Decimal @default(0) @db.Decimal(12, 2)
  sgst            Decimal @default(0) @db.Decimal(12, 2)
  igst            Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  dispatchEntry DispatchEntry @relation(fields: [dispatchEntryId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNo       String        @unique
  dispatchEntryId String        @unique
  date            DateTime
  paymentStatus   PaymentStatus @default(UNPAID)
  createdAt       DateTime      @default(now())

  dispatchEntry DispatchEntry @relation(fields: [dispatchEntryId], references: [id])
}

enum DocStatus {
  PENDING_BILLING
  BILLED
}

model Purchase {
  id              String        @id @default(uuid())
  purchaseNo      String        @unique
  vendorId        String
  vendorInvoiceNo String
  date            DateTime
  entryDate       DateTime      @default(now())
  totalAmount     Decimal       @db.Decimal(12, 2)
  totalGst        Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus        PaymentStatus @default(UNPAID)
  isCancelled          Boolean       @default(false)
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?
  createdAt            DateTime      @default(now())

  vendor         Vendor             @relation(fields: [vendorId], references: [id])
  items          PurchaseItem[]
  vendorPayments VendorPayment[]
  stockTxns      StockTransaction[]
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  cgst       Decimal @default(0) @db.Decimal(12, 2)
  sgst       Decimal @default(0) @db.Decimal(12, 2)
  igst       Decimal @default(0) @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

model VendorPayment {
  id           String      @id @default(uuid())
  vendorId     String
  purchaseId   String?
  amount       Decimal     @db.Decimal(12, 2)
  mode         PaymentMode @default(BANK_TRANSFER)
  reference    String?
  date         DateTime
  recordedById String?
  createdAt    DateTime    @default(now())

  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  recordedBy User?     @relation(fields: [recordedById], references: [id])
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  OTHER
}
